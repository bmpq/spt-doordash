<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>tarkin.doordash</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Version>1.1.2</Version>
    <RootNamespace>tarkin.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.43" IncludeAssets="compile" />
    <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.23.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(SPTPath)\BepInEx\Plugins\spt\spt-reflection.dll" />
    <Reference Include="$(SPTPath)\BepInEx\Plugins\spt\spt-common.dll" />

    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll" />
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Assembly-CSharp-firstpass.dll" />
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Comfort.dll" />
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Comfort.Unity.dll" />
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\CommonExtensions.dll" />
    <Reference Include="$(SPTPath)\EscapeFromTarkov_Data\Managed\Sirenix.Serialization.dll" />
  </ItemGroup>


  <!-- DEBUG: Deploy to BepInEx/scripts -->
  <Target Name="PostBuildDebug" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <!-- Delete old dll from plugins -->
    <Delete Files="$(SPTPath)\BepInEx\plugins\$(TargetFileName)" />

    <!-- Copy new output dll and pdb to scripts -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SPTPath)\BepInEx\scripts\" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(SPTPath)\BepInEx\scripts\" />
  </Target>

  <!-- RELEASE: Deploy to BepInEx/plugins and create release zip -->
  <Target Name="PostBuildRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <StagingDir>$(IntermediateOutputPath)zip_staging\</StagingDir>
      <ZipOutputFile>$(ProjectDir)\dist\$(TargetName)-v$(Version).zip</ZipOutputFile>
    </PropertyGroup>

    <!-- Delete old dll and pdb from scripts -->
    <Delete Files="$(SPTPath)\BepInEx\scripts\$(TargetFileName)" />
    <Delete Files="$(SPTPath)\BepInEx\scripts\$(TargetName).pdb" />

    <!-- Copy new output dll to plugins -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SPTPath)\BepInEx\plugins\" />

    <!-- Stage folder structure for the zip archive -->
    <RemoveDir Directories="$(StagingDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(StagingDir)BepInEx\plugins\" />

    <!-- Create release zip in projectroot\dist\ -->
    <Delete Files="$(ZipOutputFile)" />
    <ZipDirectory SourceDirectory="$(StagingDir)" DestinationFile="$(ZipOutputFile)" Overwrite="true" />

    <!-- Cleanup staging directory -->
    <RemoveDir Directories="$(StagingDir)" />
  </Target>

</Project>
